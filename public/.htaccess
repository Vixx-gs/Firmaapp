# Caché del navegador: la página se comprueba siempre con el servidor (si no,
# el navegador puede seguir usando una versión antigua tras un despliegue).
# Los ficheros con hash en el nombre (assets/, main-*.js…) se guardan un año.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Cabeceras de seguridad: solo HTTPS, la página no se puede incrustar en otra
# web (clickjacking), el navegador no adivina tipos de fichero y no se envía la
# dirección completa (con enlaces de firma o pases) a otros sitios.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
