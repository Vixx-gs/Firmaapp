# Caché del navegador: la página se comprueba siempre con el servidor (si no,
# el navegador puede seguir usando una versión antigua tras un despliegue).
# Los ficheros con hash en el nombre (assets/, main-*.js…) se guardan un año.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
