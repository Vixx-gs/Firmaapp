# Copia este archivo a server/.env y rellénalo.

# Conexión a PostgreSQL. Formato: postgres://usuario:contraseña@host:puerto/base
DATABASE_URL=postgres://firma:CAMBIA_ESTA_CONTRASENA@localhost:5432/firma

# Puerto propio del servidor (Plesk lo sustituye por el suyo si aplica).
PORT=4000

# URL pública de la app: se usa para construir los enlaces "?sign=" de los emails.
PUBLIC_URL=https://firma.gesticotrans.app

# Envío de correo (cuenta de Gmail con contraseña de aplicación).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: aviso por WhatsApp además del email (cuenta de Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
