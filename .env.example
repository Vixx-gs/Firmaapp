# Claves del navegador para importar desde Drive/Dropbox.
# Copia este archivo a `.env` (en la raíz, junto a package.json) y rellénalo
# ANTES de `npm run build`: Vite las incrusta en el frontend al compilar.
# Si falta alguna, el botón correspondiente avisa de que no está configurado.

# Google Cloud: OAuth client ID (tipo "Aplicación web"), API key (restringida
# por referrer) y número del proyecto. Activar "Google Picker API" y "Google Drive API".
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Dropbox App Console: "App key" de una app con el permiso files.content.read.
VITE_DROPBOX_APP_KEY=
